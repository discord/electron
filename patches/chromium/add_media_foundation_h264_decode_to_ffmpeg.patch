diff --git a/media/filters/ffmpeg_video_decoder.cc b/media/filters/ffmpeg_video_decoder.cc
index 014924d33a6ea4bf96aaddf8769527f07ef885d3..e034035e232aae5ee19a4a0bdc425778f89ff63b 100644
--- a/media/filters/ffmpeg_video_decoder.cc
+++ b/media/filters/ffmpeg_video_decoder.cc
@@ -10,6 +10,8 @@
 #include <numeric>
 
 #include "base/bits.h"
+#include "base/command_line.h"
+#include "base/compiler_specific.h"
 #include "base/containers/span.h"
 #include "base/functional/bind.h"
 #include "base/functional/callback_helpers.h"
@@ -18,6 +20,7 @@
 #include "base/numerics/safe_conversions.h"
 #include "base/task/bind_post_task.h"
 #include "base/task/sequenced_task_runner.h"
+#include "build/build_config.h"
 #include "media/base/decoder_buffer.h"
 #include "media/base/limits.h"
 #include "media/base/media_log.h"
@@ -412,9 +415,6 @@ bool FFmpegVideoDecoder::OnNewFrame(AVFrame* frame) {
     return false;
   }
 
-  auto* opaque = static_cast<OpaqueData*>(av_buffer_get_opaque(frame->buf[0]));
-  CHECK(!!opaque);
-
   // `frame->width,height` may be different from what they were when we
   // allocated the buffer.  Presumably `width` is always the same, but in
   // practice `height` can be smaller.  They are advertised as the coded size,
@@ -433,10 +433,63 @@ bool FFmpegVideoDecoder::OnNewFrame(AVFrame* frame) {
   gfx::Size natural_size = aspect_ratio.GetNaturalSize(visible_rect);
 
   const auto pts = ConvertFromTimeBase(codec_context_->pkt_timebase, frame->pts);
-  auto video_frame = VideoFrame::WrapExternalDataWithLayout(
-      opaque->layout, visible_rect, natural_size, opaque->data, pts);
-  if (!video_frame) {
-    return false;
+
+
+  scoped_refptr<VideoFrame> video_frame;
+
+#if BUILDFLAG(IS_WIN)
+  if (is_h264_mf_ && is_h264_mf_zero_copy_) {
+    // frame->data[] points directly into the locked Media Foundation buffer. No
+    // OpaqueData or FrameBufferPool involved. The MF buffer was wrapped in
+    // frame->buf[0] by mfdec.c, so its length is known and we can derive
+    // bounded per-plane spans by subspan-ing the parent buffer.
+    const gfx::Size coded_size(frame->width, frame->height);
+    base::span<const uint8_t> mf_buffer = UNSAFE_BUFFERS(base::span(
+        static_cast<const uint8_t*>(frame->buf[0]->data),
+        static_cast<size_t>(frame->buf[0]->size)));
+    const size_t y_offset =
+        static_cast<size_t>(frame->data[0] - frame->buf[0]->data);
+    const size_t u_offset =
+        static_cast<size_t>(frame->data[1] - frame->buf[0]->data);
+    const size_t v_offset =
+        static_cast<size_t>(frame->data[2] - frame->buf[0]->data);
+    const size_t uv_height = (static_cast<size_t>(frame->height) + 1) / 2;
+    const size_t y_bytes =
+        static_cast<size_t>(frame->linesize[0]) * frame->height;
+    const size_t u_bytes =
+        static_cast<size_t>(frame->linesize[1]) * uv_height;
+    const size_t v_bytes =
+        static_cast<size_t>(frame->linesize[2]) * uv_height;
+    video_frame = VideoFrame::WrapExternalYuvData(
+        PIXEL_FORMAT_I420, coded_size, visible_rect, natural_size,
+        frame->linesize[0], frame->linesize[1], frame->linesize[2],
+        mf_buffer.subspan(y_offset, y_bytes),
+        mf_buffer.subspan(u_offset, u_bytes),
+        mf_buffer.subspan(v_offset, v_bytes), pts);
+    if (!video_frame) {
+      return false;
+    }
+
+    AVBufferRef* mf_buf_ref = av_buffer_ref(frame->buf[0]);
+    if (!mf_buf_ref) {
+      return false;
+    }
+    video_frame->AddDestructionObserver(base::BindOnce(
+        [](AVBufferRef* buf) { av_buffer_unref(&buf); }, mf_buf_ref));
+  } else
+#endif  // BUILDFLAG(IS_WIN)
+  {
+    // OpaqueData was set up by GetVideoBuffer (get_buffer2).
+    auto* opaque =
+        static_cast<OpaqueData*>(av_buffer_get_opaque(frame->buf[0]));
+    CHECK(!!opaque);
+    video_frame = VideoFrame::WrapExternalDataWithLayout(
+        opaque->layout, visible_rect, natural_size, opaque->data, pts);
+    if (!video_frame) {
+      return false;
+    }
+    video_frame->AddDestructionObserver(
+        frame_pool_->CreateFrameCallback(opaque->fb_priv));
   }
 
   auto config_cs = config_.color_space_info().ToGfxColorSpace();
@@ -470,8 +523,6 @@ bool FFmpegVideoDecoder::OnNewFrame(AVFrame* frame) {
   video_frame->set_color_space(color_space.IsValid() ? color_space : config_cs);
 
   video_frame->metadata().power_efficient = false;
-  video_frame->AddDestructionObserver(
-      frame_pool_->CreateFrameCallback(opaque->fb_priv));
   output_cb_.Run(video_frame);
   return true;
 }
@@ -505,11 +556,40 @@ bool FFmpegVideoDecoder::ConfigureDecoder(const VideoDecoderConfig& config,
   // microsecond-level precision such as VideoFrame.timestamp.
   codec_context_->pkt_timebase = AVRational{1, 1000000};
 
+#if BUILDFLAG(IS_WIN)
+  const AVCodec* codec = nullptr;
+
+  if (codec_context_->codec_id == AV_CODEC_ID_H264 &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kEnableH264MF)) {
+    is_h264_mf_ = true;
+    is_h264_mf_zero_copy_ =
+        base::CommandLine::ForCurrentProcess()->HasSwitch(switches::kEnableH264MFZeroCopy);
+    // mfdec.c needs pkt_timebase to convert PTS to/from MF's 100ns timebase
+    codec_context_->pkt_timebase = {1, base::Time::kMicrosecondsPerSecond};
+    codec = avcodec_find_decoder_by_name("h264_mf");
+    MEDIA_LOG(INFO, media_log_) << "Using h264_mf decoder, zero_copy="
+                                << is_h264_mf_zero_copy_;
+  } else {
+    is_h264_mf_ = false;
+    is_h264_mf_zero_copy_ = false;
+    codec = avcodec_find_decoder(codec_context_->codec_id);
+  }
+
+  AVDictionary* opts = nullptr;
+  if (is_h264_mf_zero_copy_) {
+    av_dict_set(&opts, "zerocopy", "1", 0);
+  }
+#else
   const AVCodec* codec = avcodec_find_decoder(codec_context_->codec_id);
-  if (!codec || avcodec_open2(codec_context_.get(), codec, nullptr) < 0) {
+  AVDictionary* opts = nullptr;
+#endif
+
+  if (!codec || avcodec_open2(codec_context_.get(), codec, &opts) < 0) {
+    av_dict_free(&opts);
     ReleaseFFmpegResources();
     return false;
   }
+  av_dict_free(&opts);
 
   decoding_loop_ = std::make_unique<FFmpegDecodingLoop>(codec_context_.get());
   return true;
