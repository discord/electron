Subject: Add recording compilation timing for scripts


diff --git a/third_party/blink/renderer/bindings/core/v8/v8_script_runner.cc b/third_party/blink/renderer/bindings/core/v8/v8_script_runner.cc
index 76fe047cefa6b207e06bdcfdddc6c75c99f6046b..d03d10ae0ae183172344863bd02a1208524fb1c5 100644
--- a/third_party/blink/renderer/bindings/core/v8/v8_script_runner.cc
+++ b/third_party/blink/renderer/bindings/core/v8/v8_script_runner.cc
@@ -115,6 +115,23 @@ v8::MaybeLocal<v8::Value> ThrowStackOverflowExceptionIfNeeded(
   return result;
 }
 
+// Callback for script compilation timing observers (e.g. Electron).
+// Set once during renderer init, read on the main thread during compile —
+// no synchronization needed.
+static V8ScriptRunner::CompilationTimingCallback g_compilation_timing_callback =
+    nullptr;
+
+void RecordCompilationTiming(
+    const String& url,
+    const v8::ScriptCompiler::CompilationDetails& details,
+    bool streamed) {
+  if (g_compilation_timing_callback) {
+    g_compilation_timing_callback(
+        url.Utf8(), details.foreground_time_in_microseconds,
+        details.background_time_in_microseconds, streamed);
+  }
+}
+
 v8::MaybeLocal<v8::Script> CompileScriptInternal(
     v8::Isolate* isolate,
     ScriptState* script_state,
@@ -143,9 +160,13 @@ v8::MaybeLocal<v8::Script> CompileScriptInternal(
             streamer->Source(v8::ScriptType::kClassic)) {
       // Final compile call for a streamed compilation.
       // Streaming compilation may involve use of code cache.
-      // TODO(leszeks): Add compile timer to streaming compilation.
-      return v8::ScriptCompiler::Compile(script_state->GetContext(), source,
-                                         code, origin);
+      v8::MaybeLocal<v8::Script> script =
+          v8::ScriptCompiler::Compile(script_state->GetContext(), source,
+                                      code, origin);
+      RecordCompilationTiming(classic_script.SourceUrl(),
+                              source->compilation_details(),
+                              /*streamed=*/true);
+      return script;
     }
   }
 
@@ -162,6 +183,9 @@ v8::MaybeLocal<v8::Script> CompileScriptInternal(
     v8::MaybeLocal<v8::Script> script =
         v8::ScriptCompiler::Compile(script_state->GetContext(), &source,
                                     v8::ScriptCompiler::kConsumeCodeCache);
+    RecordCompilationTiming(classic_script.SourceUrl(),
+                            source.GetCompilationDetails(),
+                            /*streamed=*/false);
     return script;
   }
 
@@ -271,6 +295,9 @@ v8::MaybeLocal<v8::Script> CompileScriptInternal(
     v8::MaybeLocal<v8::Script> script =
         v8::ScriptCompiler::Compile(script_state->GetContext(), &source,
                                     v8::ScriptCompiler::kConsumeCodeCache);
+    RecordCompilationTiming(classic_script.SourceUrl(),
+                            source.GetCompilationDetails(),
+                            /*streamed=*/false);
     cache_handler->DidUseCodeCache(cached_data->rejected);
     if (cached_data->rejected) {
       // The ScriptState has an associated context. We expect the current
@@ -310,6 +337,12 @@ int GetMicrotasksScopeDepth(v8::Isolate* isolate,
 
 }  // namespace
 
+// static
+void V8ScriptRunner::SetCompilationTimingCallback(
+    CompilationTimingCallback callback) {
+  g_compilation_timing_callback = callback;
+}
