+std::vector<base::UnguessableToken> GetSourceFrameTokens(
+    RenderFrameHost* frame) {
+  std::vector<base::UnguessableToken> tokens;
+  for (RenderFrameHost* rfh = frame; rfh;
+       rfh = rfh->GetParentOrOuterDocument()) {
+    tokens.push_back(rfh->GetDevToolsFrameToken());
+  }
+  return tokens;
+}
