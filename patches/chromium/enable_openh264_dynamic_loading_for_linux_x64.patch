From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chris Harris <chris.harris@discordapp.com>
Date: Thu, 19 Feb 2026 13:11:55 -0800
Subject: Enable OpenH264 dynamic loading for Linux x64


diff --git a/content/browser/renderer_host/render_process_host_impl.cc b/content/browser/renderer_host/render_process_host_impl.cc
index 73b064808ebf833224298563dbd07f0b8b35ca3c..dcbfc72f306cb2238c1d5aee57de1442aff93a99 100644
--- a/content/browser/renderer_host/render_process_host_impl.cc
+++ b/content/browser/renderer_host/render_process_host_impl.cc
@@ -4011,6 +4011,10 @@ void RenderProcessHostImpl::PropagateBrowserCommandLineToRenderer(
       switches::kEnableH264MF,
       switches::kEnableH264MFZeroCopy,
 #endif
+#if BUILDFLAG(IS_LINUX)
+      switches::kOpenH264LibraryPath,
+      switches::kEnableLibOpenH264,
+#endif
 #if BUILDFLAG(IS_OZONE)
       switches::kOzonePlatform,
 #endif
diff --git a/media/base/media_switches.cc b/media/base/media_switches.cc
index 2f762ce65834cb423e1e04a787215c21a66da362..4955379ce4ce9004e30031d31c6db3b5cb3caeb6 100644
--- a/media/base/media_switches.cc
+++ b/media/base/media_switches.cc
@@ -333,6 +333,17 @@ const char kTrySupportedChannelLayouts[] = "try-supported-channel-layouts";
 const char kWaveOutBuffers[] = "waveout-buffers";
 #endif  // BUILDFLAG(IS_WIN)
 
+#if BUILDFLAG(IS_LINUX)
+// When enabled, FFmpegVideoDecoder will use
+// avcodec_find_decoder_by_name("libopenh264") to prefer Cisco Openh264 wrapper
+// h264 decode instead of its default software decoder.
+const char kEnableLibOpenH264[] = "enable-libopenh264";
+
+// Specifies the path to the libopenh264 library. If not set, defaults to
+// "libopenh264.so" on the library search path.
+const char kOpenH264LibraryPath[] = "openh264-library-path";
+#endif
+
 #if BUILDFLAG(USE_CRAS)
 // Enforce system audio echo cancellation.
 const char kSystemAecEnabled[] = "system-aec-enabled";
diff --git a/media/base/media_switches.h b/media/base/media_switches.h
index 0ac83eed44fbff97896956d89d4aff20caf749bb..39d065e168877fa7b709077c33523c29faa049c4 100644
--- a/media/base/media_switches.h
+++ b/media/base/media_switches.h
@@ -105,6 +105,11 @@ MEDIA_EXPORT extern const char kWaveOutBuffers[];
 MEDIA_EXPORT extern const char kEnableH264MF[];
 MEDIA_EXPORT extern const char kEnableH264MFZeroCopy[];
 #endif  // BUILDFLAG(IS_WIN)
+ 
+#if BUILDFLAG(IS_LINUX)
+MEDIA_EXPORT extern const char kEnableLibOpenH264[];
+MEDIA_EXPORT extern const char kOpenH264LibraryPath[];
+#endif
 
 #if BUILDFLAG(USE_CRAS)
 MEDIA_EXPORT extern const char kSystemAecEnabled[];
diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
index 483138ccf1ccb72fb3dde4bdecc957d4c535105d..6b21e32e71142f03647e9cd01c1dfe3c17914b82 100644
--- a/media/ffmpeg/ffmpeg_common.cc
+++ b/media/ffmpeg/ffmpeg_common.cc
@@ -69,7 +69,7 @@ VideoColorSpace GetGuessedColorSpace(const VideoColorSpace& color_space) {
 const char* GetAllowedVideoDecoders() {
   // This should match the configured lists in //third_party/ffmpeg.
 #if BUILDFLAG(USE_PROPRIETARY_CODECS) && BUILDFLAG(ENABLE_FFMPEG_VIDEO_DECODERS)
-  return "h264,h264_mf";
+  return "h264,h264_mf,libopenh264";
 #else
   return "";
 #endif
diff --git a/media/ffmpeg/scripts/build_ffmpeg.py b/media/ffmpeg/scripts/build_ffmpeg.py
index 46ba41f004d6844c4568ab02b6905d4eaf833a2b..f0bbb9071ccc49cf586dcb22c52cb41ce4dbc1f5 100755
--- a/media/ffmpeg/scripts/build_ffmpeg.py
+++ b/media/ffmpeg/scripts/build_ffmpeg.py
@@ -731,6 +731,8 @@ def ConfigureAndBuild(target_arch, target_os, host_os, host_arch,
                     '--enable-lto',
                     '--arch=x86_64',
                     '--target-os=linux',
+                    '--enable-libopenh264',
+                    '--enable-decoder=libopenh264',
                 ])
 
                 if host_arch != 'x64':
diff --git a/media/ffmpeg/scripts/generate_gn.py b/media/ffmpeg/scripts/generate_gn.py
index d4fce5292c988cc8a44d90ef80301ff5dbfb8bce..449e87aaf9cf6f3d01d5f068ad586aa8ea9d3570 100755
--- a/media/ffmpeg/scripts/generate_gn.py
+++ b/media/ffmpeg/scripts/generate_gn.py
@@ -721,6 +721,8 @@ ALLOWED_LICENSES = [
     'BSD (2 clause) LGPL (v2.1 or later)',
     'BSD (3 clause) LGPL (v2.1 or later)',
     'BSL (v1) LGPL (v2.1 or later)',
+    'BSD (2 clause)',
+    'GENERATED FILE',
     'ISC GENERATED FILE',
     'LGPL (v2.1 or later)',
     'LGPL (v2.1 or later) GENERATED FILE',
diff --git a/media/filters/ffmpeg_video_decoder.cc b/media/filters/ffmpeg_video_decoder.cc
index bf317490e20e2c80f706858b764800e546e03a45..0835cd912f0920854f8c7c4aa6cc74d74e1763ef 100644
--- a/media/filters/ffmpeg_video_decoder.cc
+++ b/media/filters/ffmpeg_video_decoder.cc
@@ -34,6 +34,12 @@
 #include "media/ffmpeg/ffmpeg_decoding_loop.h"
 #include "media/filters/ffmpeg_glue.h"
 
+#if BUILDFLAG(IS_LINUX)
+extern "C" {
+void ff_libopenh264_set_library_path(const char* path);
+}
+#endif
+
 namespace media {
 
 namespace {
@@ -587,6 +593,27 @@ bool FFmpegVideoDecoder::ConfigureDecoder(const VideoDecoderConfig& config,
   if (is_h264_mf_zero_copy_) {
     av_dict_set(&opts, "zerocopy", "1", 0);
   }
+#elif BUILDFLAG(IS_LINUX)
+  const AVCodec* codec = nullptr;
+  AVDictionary* opts = nullptr;
+
+  if (codec_context_->codec_id == AV_CODEC_ID_H264 &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          switches::kEnableLibOpenH264)) {
+    // Set custom library path if provided before attempting to load
+    if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+            switches::kOpenH264LibraryPath)) {
+      std::string library_path = base::CommandLine::ForCurrentProcess()
+                                      ->GetSwitchValueASCII(switches::kOpenH264LibraryPath);
+      ff_libopenh264_set_library_path(library_path.c_str());
+      MEDIA_LOG(INFO, media_log_) << "Setting OpenH264 library path to: " << library_path;
+    }
+
+    codec = avcodec_find_decoder_by_name("libopenh264");
+    MEDIA_LOG(INFO, media_log_) << "Using libopenh264 decoder";
+  } else {
+    codec = avcodec_find_decoder(codec_context_->codec_id);
+  }
 #else
   const AVCodec* codec = avcodec_find_decoder(codec_context_->codec_id);
   AVDictionary* opts = nullptr;
