+void FrameSinkManagerImpl::SetMinFrameInterval(const FrameSinkId& id,
+                                               ::base::TimeDelta interval) {
+  if (!id.is_valid()) {
+    for (const auto& root : root_sink_map_) {
+      root.second->SetMinFrameInterval(interval);
+    }
+    return;
+  }
+
+  if (auto it = root_sink_map_.find(id); it != root_sink_map_.end()) {
+    it->second->SetMinFrameInterval(interval);
+  } else {
+    if (auto sink_source_it = frame_sink_source_map_.find(id);
+        sink_source_it != frame_sink_source_map_.end()) {
+      for (const auto& parent : sink_source_it->second.parent) {
+        if (auto root_it = root_sink_map_.find(parent);
+            root_it != root_sink_map_.end()) {
+          SetMinFrameInterval(parent, interval);
+          return;
+        }
+      }
+    }
+  }
+}
 
