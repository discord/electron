diff --git a/media/ffmpeg/scripts/generate_gn.py b/media/ffmpeg/scripts/generate_gn.py
index 058fce8daffc69c25de45e471eff8f71828fa430..92b25eefd68db0cd4160aee4414726ca9184b840 100755
--- a/media/ffmpeg/scripts/generate_gn.py
+++ b/media/ffmpeg/scripts/generate_gn.py
@@ -783,8 +783,10 @@ def GetIncludedSources(file_path, source_dir, include_set, scan_only=False):
     if not os.path.isabs(file_path):
         file_path = os.path.abspath(os.path.join(source_dir, file_path))
     file_path = os.path.normpath(file_path)
+    parent_path = os.path.normpath(os.path.join(file_path, '..'))
 
     current_dir = os.path.dirname(file_path)
+    parent_dir = os.path.dirname(parent_path)
 
     # Already processed this file, bail out.
     if file_path in include_set:
@@ -809,6 +811,8 @@ def GetIncludedSources(file_path, source_dir, include_set, scan_only=False):
         # and we'll checking their validity below.
         include_path_in_current_dir = os.path.join(current_dir,
                                                    include_file_path)
+        include_path_in_current_parent_dir = os.path.join(parent_dir,
+                                                          include_file_path)
         include_path_in_source_dir = os.path.join(source_dir,
                                                   include_file_path)
         resolved_include_path = ''
@@ -819,6 +823,9 @@ def GetIncludedSources(file_path, source_dir, include_set, scan_only=False):
         # Else, check source_dir (should be FFmpeg root).
         elif os.path.isfile(include_path_in_source_dir):
             resolved_include_path = include_path_in_source_dir
+        # Else, check parent_dir
+        elif os.path.isfile(include_path_in_current_parent_dir):
+            resolved_include_path = include_path_in_current_parent_dir
         # Else, we couldn't find it :(.
         elif include_file_path in IGNORED_INCLUDE_FILES:
             continue
