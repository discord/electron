diff --git a/media/ffmpeg/ffmpeg_common.cc b/media/ffmpeg/ffmpeg_common.cc
index 6b21e32e71142f03647e9cd01c1dfe3c17914b82..0a9ed1e3e8ba6bbe184181ff9234f5b8ed688ef7 100644
