 }
+
+/* Functions and storage to dynamically load libopenh264 */
+
+WelsCreateSVCEncoderFunc ff_WelsCreateSVCEncoder = NULL;
+WelsDestroySVCEncoderFunc ff_WelsDestroySVCEncoder = NULL;
+WelsCreateDecoderFunc ff_WelsCreateDecoder = NULL;
+WelsDestroyDecoderFunc ff_WelsDestroyDecoder = NULL;
+
+static void* openh264_handle = NULL;
+static int openh264_load_attempted = 0;
+static char* custom_library_path = NULL;
+static AVMutex openh264_mutex = AV_MUTEX_INITIALIZER;
+
+void ff_libopenh264_set_library_path(const char* path) {
+  ff_mutex_lock(&openh264_mutex);
+  if (!openh264_load_attempted) {
+    free(custom_library_path);
+    custom_library_path = path ? strdup(path) : NULL;
+  }
+  ff_mutex_unlock(&openh264_mutex);
+}
+
+const char* ff_libopenh264_get_library_path(void) {
+  return custom_library_path;
+}
+
+void ff_libopenh264_unload_library(void) {
+  ff_mutex_lock(&openh264_mutex);
+  if (openh264_handle) {
+    dlclose(openh264_handle);
+    openh264_handle = NULL;
+  }
+  free(custom_library_path);
+  custom_library_path = NULL;
+  ff_WelsCreateSVCEncoder = NULL;
+  ff_WelsDestroySVCEncoder = NULL;
+  ff_WelsCreateDecoder = NULL;
+  ff_WelsDestroyDecoder = NULL;
+  openh264_load_attempted = 0;
+  ff_mutex_unlock(&openh264_mutex);
+}
+
+int ff_libopenh264_load_library(void* logctx) {
+  const char* library_path;
+  int ret = 0;
+
+  ff_mutex_lock(&openh264_mutex);
+
+  if (openh264_load_attempted) {
+    ret = openh264_handle ? 0 : AVERROR_EXTERNAL;
+    goto done;
+  }
+
+  library_path = custom_library_path;
+  if (!library_path) {
+    ret = AVERROR_EXTERNAL;
+    goto done;
+  }
+
+  openh264_load_attempted = 1;
+
+  openh264_handle = dlopen(library_path, RTLD_NOW | RTLD_LOCAL);
+  if (!openh264_handle) {
+    av_log(logctx, AV_LOG_WARNING,
+           "Failed to load OpenH264 library from %s: %s\n", library_path,
+           dlerror());
+    ret = AVERROR_EXTERNAL;
+    goto done;
+  }
+
+  ff_WelsCreateSVCEncoder =
+      (WelsCreateSVCEncoderFunc)dlsym(openh264_handle, "WelsCreateSVCEncoder");
+  ff_WelsDestroySVCEncoder = (WelsDestroySVCEncoderFunc)dlsym(
+      openh264_handle, "WelsDestroySVCEncoder");
+  ff_WelsCreateDecoder =
+      (WelsCreateDecoderFunc)dlsym(openh264_handle, "WelsCreateDecoder");
+  ff_WelsDestroyDecoder =
+      (WelsDestroyDecoderFunc)dlsym(openh264_handle, "WelsDestroyDecoder");
+
+  if (!ff_WelsCreateSVCEncoder || !ff_WelsDestroySVCEncoder ||
+      !ff_WelsCreateDecoder || !ff_WelsDestroyDecoder) {
+    av_log(logctx, AV_LOG_ERROR, "Failed to load OpenH264 function symbols\n");
+    dlclose(openh264_handle);
+    openh264_handle = NULL;
+    ff_WelsCreateSVCEncoder = NULL;
+    ff_WelsDestroySVCEncoder = NULL;
+    ff_WelsCreateDecoder = NULL;
+    ff_WelsDestroyDecoder = NULL;
+    ret = AVERROR_EXTERNAL;
+    goto done;
+  }
+
+  av_log(logctx, AV_LOG_VERBOSE,
+         "Successfully loaded OpenH264 library from %s\n", library_path);
+
+done:
+  ff_mutex_unlock(&openh264_mutex);
+  return ret;
+}
