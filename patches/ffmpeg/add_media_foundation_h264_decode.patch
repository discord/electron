diff --git a/libavcodec/mfdec.c b/libavcodec/mfdec.c
new file mode 100644
index 0000000000000000000000000000000000000000..17bbf5dfcea1363a604f0a8619c227caf9694511
--- /dev/null
+++ b/libavcodec/mfdec.c
@@ -0,0 +1,1055 @@
