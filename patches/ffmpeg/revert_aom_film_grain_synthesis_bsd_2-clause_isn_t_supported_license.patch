-
-#if BIT_DEPTH > 8
-# define entry int16_t
-# define bitdepth_max ((1 << bitdepth) - 1)
-# define HBD_DECL , const int bitdepth
-# define HBD_CALL , bitdepth
-# define SCALING_SIZE 4096
-#else
